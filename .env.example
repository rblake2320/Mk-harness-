# Docker Compose development configuration. Copy to .env and replace secrets.
POSTGRES_PASSWORD=change-me-random-database-password
JWT_SECRET=change-me-64-random-bytes
MASTER_KEY=
CORS_ORIGINS=http://localhost:8080

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
RATE_LIMIT_PER_MINUTE=30

# Governed Agent Operations is opt-in. Empty allowlists deny registration/tasks.
AGENT_OPERATIONS_ENABLED=false
AGENT_OPERATIONS_WEBHOOK_HOSTS=
AGENT_OPERATIONS_TARGET_HOSTS=
AGENT_OPERATIONS_PUBLIC_BASE_URL=
AGENT_OPERATIONS_DISPATCH_TIMEOUT_SECONDS=10
