{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.consultant-studio.invalid/agent-ops/v1/mobile-work-order.schema.json",
  "title": "Consultant Studio mobile work order v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "adapter", "upstream_contract", "verified_on_device", "workflow",
    "steps", "clawscript_source", "adapter_actions_required", "result_fields",
    "task_id", "agent_id", "callback_url", "callback_auth"
  ],
  "properties": {
    "schema": {"const": "consultant-studio.mobile-work-order.v1"},
    "adapter": {"const": "mobile-adapter-v1"},
    "upstream_contract": {"type": "string", "minLength": 1, "maxLength": 200},
    "verified_on_device": {"const": false},
    "workflow": {
      "enum": ["follow_up", "appointment", "order_status", "recruit_outreach", "social_post"]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/step"}
    },
    "clawscript_source": {"type": "string", "minLength": 1, "maxLength": 32768},
    "adapter_actions_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["input", "open", "open_url"]}
    },
    "result_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"}
    },
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "agent_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"},
    "callback_url": {"type": "string", "minLength": 1, "maxLength": 2048},
    "callback_auth": {"const": "hmac-sha256-v1"}
  },
  "$defs": {
    "step": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "target"],
          "properties": {
            "action": {"const": "open"},
            "target": {"enum": ["sms", "instagram", "facebook", "tiktok", "x"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "url"],
          "properties": {
            "action": {"const": "open_url"},
            "url": {"type": "string", "pattern": "^https://", "maxLength": 2048}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "description"],
          "properties": {
            "action": {"const": "click"},
            "description": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "field", "value"],
          "properties": {
            "action": {"const": "input"},
            "field": {"type": "string", "minLength": 1, "maxLength": 80},
            "value": {"type": "string", "maxLength": 10000}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "description", "return_as"],
          "properties": {
            "action": {"const": "scrape"},
            "description": {"type": "string", "minLength": 1, "maxLength": 500},
            "return_as": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"}
          }
        }
      ]
    }
  }
}
