# Managed secrets + KMS envelope encryption (contract D5, S6, S10).
# One CMK per concern; rotation enabled; the kernel KEK is a KMS data key
# stored sealed in Secrets Manager and injected as MK_KEK (kernel/keys.rs wraps
# every DEK version with it; mk-keyctl rotates the DEK, Secrets Manager
# rotation of this secret is the KEK rotation path in docs/runbooks/key-compromise.md).
resource "aws_kms_key" "data" {
  description             = "${local.name} RDS / Redis / S3 at-rest key"
  enable_key_rotation     = true
  deletion_window_in_days = 30
  tags                    = local.tags
}

resource "aws_kms_key" "secrets" {
  description             = "${local.name} Secrets Manager key (master key, KEK, assertion keys, provider tokens)"
  enable_key_rotation     = true
  deletion_window_in_days = 30
  tags                    = local.tags
}

resource "aws_kms_key" "logs" {
  description             = "${local.name} CloudWatch logs key"
  enable_key_rotation     = true
  deletion_window_in_days = 30
  tags                    = local.tags
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "root"
        Effect    = "Allow"
        Principal = { AWS = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:root" }
        Action    = "kms:*"
        Resource  = "*"
      },
      {
        Sid       = "logs"
        Effect    = "Allow"
        Principal = { Service = "logs.${var.region}.amazonaws.com" }
        Action    = ["kms:Encrypt*", "kms:Decrypt*", "kms:ReEncrypt*", "kms:GenerateDataKey*", "kms:Describe*"]
        Resource  = "*"
      }
    ]
  })
}

data "aws_caller_identity" "current" {}

# Secrets are created EMPTY. Values are set by an operator with `aws secretsmanager
# put-secret-value` (or generated by rotation lambdas); Terraform never holds
# a secret value and the state file therefore never contains one.
locals {
  secret_names = {
    master_key           = "MK_MASTER_KEY — base64 32 bytes; shared by FastAPI and kernel (legacy seal + destination fingerprints)"
    kek                  = "MK_KEK — base64 32 bytes; wraps kernel data-key versions (rotate per docs/runbooks/key-compromise.md)"
    assertion_private    = "KERNEL_ASSERTION_PRIVATE_KEY — FastAPI Ed25519 seed; kernel holds only the public key in MK_ASSERTION_KEYS"
    jwt_secret           = "JWT_SECRET — application sessions"
    db_api_password      = "mk_api_login"
    db_worker_password   = "mk_worker_login"
    db_relay_password    = "mk_relay_login"
    db_readonly_password = "mk_readonly_login"
    db_app_password      = "application login"
    stripe               = "STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET"
  }
}

resource "aws_secretsmanager_secret" "this" {
  for_each                = local.secret_names
  name                    = "${local.name}/${each.key}"
  description             = each.value
  kms_key_id              = aws_kms_key.secrets.arn
  recovery_window_in_days = local.is_prod ? 30 : 7
  tags                    = local.tags
}

# Provider credentials are NOT here: Twilio tokens are sealed per sender
# identity inside the kernel database (kernel.sender_identities), never in
# environment or Secrets Manager.
