# Rust action kernel — production environment template.
# Copy to .env (never tracked) and fill with scripts/kernel-secrets.ps1 (Windows)
# or scripts/kernel-secrets.sh. Every value below is required unless marked.
#
# Used together with the main .env (POSTGRES_PASSWORD, JWT_SECRET, MASTER_KEY, …):
#   docker compose -f docker-compose.yml -f docker-compose.kernel.yml up -d

# ---- shared with FastAPI -----------------------------------------------------
# MASTER_KEY               (main .env) base64 32 bytes; kernel reads it as MK_MASTER_KEY

# ---- assertion keys: FastAPI signs, kernel verifies ---------------------------
# Public half, kid=base64url(32-byte Ed25519 public key); several allowed during rotation: k1=…,k2=…
MK_ASSERTION_KEYS=
# Private half (base64url 32-byte seed). FastAPI only. Rotate by adding k2 to MK_ASSERTION_KEYS,
# switching KERNEL_ASSERTION_KID/PRIVATE_KEY to k2, then removing k1 after 2 minutes.
KERNEL_ASSERTION_PRIVATE_KEY=
KERNEL_ASSERTION_KID=k1

# ---- per-process database identities (deploy/kernel/roles.sql, >= 16 chars) ---
MK_DB_API_PASSWORD=
MK_DB_WORKER_PASSWORD=
MK_DB_RELAY_PASSWORD=
MK_DB_READONLY_PASSWORD=

# ---- dispatch controls --------------------------------------------------------
# Leave UNSET (or 0) until scripts/kernel-preflight.sh passes AND the real-device
# acceptance (docs/real-device-acceptance.md) has been reviewed. 0 = shadow mode:
# proposals are evaluated, approved and audited but never enqueued.
RUST_ACTION_KERNEL_ENABLED=0
# User ids (application User.id) allowed to flip the GLOBAL kill switch. Optional.
KERNEL_PLATFORM_OPERATORS=

# ---- device agents ------------------------------------------------------------
# Where the worker delivers work orders. {agent_id} is substituted per adapter.
MK_MOBILE_INTAKE_URL=https://adapters.internal/agents/{agent_id}/work-orders
# host[:port] list the worker may call; must include the intake host and the
# callback authorities registered for adapters. Nothing else is reachable.
MK_EGRESS_AUTHORITIES=adapters.internal

# ---- optional tuning ----------------------------------------------------------
# MK_CALLBACK_TOLERANCE_SECS=120
# MK_LEASE_SECS=60
# MK_WORKER_BATCH=16
