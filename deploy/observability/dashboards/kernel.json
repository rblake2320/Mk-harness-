     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "type": "row",
   "title": "Queue and dispatch (O3: approved \u2192 dispatch start p95 \u2264 10 s / p99 \u2264 60 s)",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 1
