   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   }
  },
  {
   "id": 8,
   "type": "row",
   "title": "API availability and latency (O3: p95 \u2264 500 ms, p99 \u2264 1.5 s, non-AI routes)",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Request rate by status",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(mk_requests_total[5m]))",
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "5xx error ratio",
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(mk_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(mk_requests_total[5m])),0.001)",
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Latency p95 / p99 (all routes)",
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(mk_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(mk_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Latency p95 by route",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(mk_request_duration_seconds_bucket[5m])))",
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
