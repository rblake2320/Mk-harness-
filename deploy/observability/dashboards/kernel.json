 "annotations": {
  "list": [
   {
    "name": "Kill switch",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS}"
    },
    "expr": "changes(mk_kill_switch_global_enabled[1m]) > 0",
    "titleFormat": "global switch changed",
    "enable": true
   }
  ]
 }
}